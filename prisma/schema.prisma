generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
}

model Lead {
  id             Int      @id @default(autoincrement())
  trackingId     String   @unique
  name           String
  email          String
  phone          String
  service        String
  message        String
  status         String   @default("New")
  createdAt      DateTime @default(now())
  country        String?
  dob            String?
  fatherName     String?
  maritalStatus  String?
  motherName     String?
  passportExpiry String?
  passportNumber String?
  spouseName     String?
  tenantId       Int?
  files          File[]
  Tenant         Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model File {
  id       Int    @id @default(autoincrement())
  leadId   Int
  fileUrl  String
  fileType String
  fileName String
  lead     Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
  tenantId  Int?
  Tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model User {
  id                 Int                  @id @default(autoincrement())
  email              String               @unique
  passwordHash       String
  name               String
  role               UserRole             @default(CLIENT)
  status             String               @default("ACTIVE")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  tenantId           Int?
  resetToken         String?
  image              String?
  resetTokenExpiry   DateTime?
  agentProfile       AgentProfile?
  auditLogs          AuditLog[]
  blogs              Blog[]
  CRMLead            CRMLead[]
  CaseActivity       CaseActivity[]
  CaseTask           CaseTask[]
  clientProfile      ClientProfile?
  FinanceTransaction FinanceTransaction[]
  recvMessages       Message[]            @relation("Receiver")
  sentMessages       Message[]            @relation("Sender")
  notifications      Notification[]
  verifiedPayments   Payment[]            @relation("VerifiedBy")
  StaffProfile       StaffProfile?
  staffTasks         Task[]               @relation("AssignedTo")
  createdTasks       Task[]               @relation("CreatedBy")
  Tenant             Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  VisaCase           VisaCase[]
}

model ClientProfile {
  id                     Int                  @id @default(autoincrement())
  userId                 Int                  @unique
  phone                  String?
  companyName            String?
  address                String?
  clientType             String               @default("INDIVIDUAL")
  creditLimit            Float?               @default(0)
  taxNumber              String?
  dob                    String?
  passportExpiryDate     String?
  passportNumber         String?
  profession             String?
  agentId                Int?
  gender                 String?
  nationality            String?
  birthPlace             String?
  cnicNumber             String?
  currentAddress         String?
  fatherName             String?
  maritalStatus          String?
  passportIssueDate      String?
  passportIssuePlace     String?
  permanentAddress       String?
  qualification          String?
  religion               String?
  motherName             String?
  spouseName             String?
  childrenCount          Int?                 @default(0)
  emergencyContact       String?
  bachelor               String?
  cgpa                   String?
  college                String?
  graduationYear         String?
  highSchool             String?
  master                 String?
  position               String?
  salary                 String?
  city                   String?
  clientCode             String?              @unique
  countryOfResidence     String?
  customerCategory       String?              @default("INDIVIDUAL")
  leadSource             String?              @default("DIRECT")
  postalCode             String?
  preferredContactMethod String?              @default("WHATSAPP")
  preferredCurrency      String?              @default("USD")
  secondaryPhone         String?
  tags                   String[]
  vipStatus              Boolean              @default(false)
  whatsappNumber         String?
  employerAddress        String?
  experienceYears        String?
  tenantId               Int?
  givenName              String?
  surname                String?
  childrenDetails        String?
  applications           Application[]
  appointments           Appointment[]
  ClientDocument         ClientDocument[]
  ClientNote             ClientNote[]
  agent                  AgentProfile?        @relation("AgentClients", fields: [agentId], references: [id])
  Tenant                 Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  ClientTimeline         ClientTimeline[]
  FinanceTransaction     FinanceTransaction[]
  SmartContract          SmartContract[]
  VisaCase               VisaCase[]

  @@index([tenantId, clientCode])
  @@index([tenantId, customerCategory])
  @@index([tenantId, passportNumber])
  @@index([tenantId, phone])
}

model AgentProfile {
  id                 Int             @id @default(autoincrement())
  userId             Int             @unique
  agentCode          String          @unique
  agencyName         String
  phone              String?         @default("")
  commission         Float           @default(0.0)
  licenseCertificate String?
  licenseNumber      String?
  officeAddress      String?
  whatsappNumber     String?
  commissionRate     Float?          @default(0.0)
  agencyAddress      String?
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications       Application[]
  appointments       Appointment[]
  clients            ClientProfile[] @relation("AgentClients")
}

model Application {
  id                     Int                        @id @default(autoincrement())
  clientId               Int
  agentId                Int?
  country                String
  visaCategory           String
  duration               String?
  entryType              String?
  travelDate             String?
  returnDate             String?
  purpose                String?
  sponsor                String?
  reference              String?
  visitedCountries       String?
  previousVisas          String?
  visaRefusals           String?
  previousPassportNumber String?
  status                 ApplicationStatus          @default(DRAFT)
  contractApprovedDays   String?
  contractPaymentAmount  String?
  contractFirstPartyName String?
  contractStatus         String?                    @default("PENDING")
  contractAccepted       Boolean                    @default(false)
  contractAcceptedAt     DateTime?
  contractSignatureName  String?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  tenantId               Int?
  applicantId            Int?
  applicationNumber      String?                    @unique
  biometricFee           Float                      @default(0)
  courierFee             Float                      @default(0)
  discount               Float                      @default(0)
  embassyFee             Float                      @default(0)
  insuranceFee           Float                      @default(0)
  medicalFee             Float                      @default(0)
  otherCharges           Float                      @default(0)
  serviceFee             Float                      @default(0)
  tax                    Float                      @default(0)
  totalAmount            Float                      @default(0)
  visaFee                Float                      @default(0)
  trackingId             String?                    @unique
  assignedStaffId        Int?
  packageId              Int?
  packagePrice           Float?
  agent                  AgentProfile?              @relation(fields: [agentId], references: [id])
  Applicant              Applicant?                 @relation(fields: [applicantId], references: [id])
  client                 ClientProfile              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  package                Package?                   @relation(fields: [packageId], references: [id])
  Tenant                 Tenant?                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  statusHistory          ApplicationStatusHistory[]
  documents              Document[]
  FinanceTransaction     FinanceTransaction[]
  invoices               Invoice[]
  PublicTracking         PublicTracking[]
}

model ApplicationStatusHistory {
  id            Int               @id @default(autoincrement())
  applicationId Int
  status        ApplicationStatus
  notes         String?
  updatedById   Int
  createdAt     DateTime          @default(now())
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Document {
  id                   Int         @id @default(autoincrement())
  applicationId        Int
  documentType         String
  fileUrl              String
  fileName             String
  fileSize             Int?
  fileType             String
  version              Int         @default(1)
  createdAt            DateTime    @default(now())
  confidenceLevel      String?     @default("HIGH")
  confidencePercentage Int?        @default(90)
  detectedType         String?
  fileHash             String?
  isConfirmed          Boolean     @default(false)
  application          Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([fileHash])
}

model Appointment {
  id              Int               @id @default(autoincrement())
  clientId        Int?
  agentId         Int?
  date            DateTime          @default(now())
  timeSlot        String?
  status          AppointmentStatus @default(SCHEDULED)
  notes           String?
  createdAt       DateTime          @default(now())
  tenantId        Int?
  appointmentDate DateTime          @default(now())
  location        String?
  serviceType     String            @default("CONSULTATION")
  title           String            @default("Appointment")
  agent           AgentProfile?     @relation(fields: [agentId], references: [id])
  client          ClientProfile?    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  Tenant          Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Invoice {
  id                   Int                  @id @default(autoincrement())
  invoiceNumber        String               @unique
  applicationId        Int?
  totalAmount          Float                @default(0)
  status               PaymentStatus        @default(UNPAID)
  dueDate              DateTime
  createdAt            DateTime             @default(now())
  tenantId             Int?
  balanceAmount        Float                @default(0)
  currency             String               @default("USD")
  paidAmount           Float                @default(0)
  applicantNames       String[]             @default([])
  bankInfoJson         String?
  businessRegistration String?
  clientName           String?
  clientType           String               @default("INDIVIDUAL")
  companyName          String?
  discountAmount       Float                @default(0)
  discountType         String?              @default("FLAT")
  discountValue        Float                @default(0)
  nationality          String?
  notes                String?
  passportNumbers      String[]             @default([])
  paymentTermsDays     Int                  @default(15)
  processingType       String?              @default("NORMAL")
  returnDate           String?
  subtotalAmount       Float                @default(0)
  taxAmount            Float                @default(0)
  taxNumber            String?
  taxRate              Float                @default(0)
  taxType              String?              @default("VAT")
  termsConditions      String?
  travelDate           String?
  visaCountry          String?
  visaType             String?
  customerEmail        String?
  customerPhone        String?
  customerAddress      String?
  customerCity         String?
  customerCountry      String?
  accessToken          String?              @unique
  shippingFee          Float                @default(0)
  issueDate            DateTime             @default(now())
  emailLogs            InvoiceEmailLog[]
  CreditNote           CreditNote[]
  FinanceTransaction   FinanceTransaction[]
  application          Application?         @relation(fields: [applicationId], references: [id])
  Tenant               Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items                InvoiceItem[]
  payments             Payment[]
  Refund               Refund[]
  SmartContract        SmartContract[]
}

model InvoiceItem {
  id            Int      @id @default(autoincrement())
  invoiceId     Int
  serviceName   String?
  description   String
  quantity      Int      @default(1)
  unit          String?  @default("service")
  unitPrice     Float
  amount        Float
  discount      Float    @default(0)
  discountType  String?  @default("PERCENTAGE")
  discountValue Float    @default(0)
  serviceType   String?  @default("SERVICE_CHARGE")
  tax           Float    @default(0)
  taxRate       Float    @default(0)
  sortOrder     Int      @default(0)
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id                Int           @id @default(autoincrement())
  invoiceId         Int
  amount            Float
  paymentMethod     PaymentMethod
  transactionId     String?
  receiptUrl        String?
  status            String        @default("VERIFIED")
  verifiedById      Int?
  createdAt         DateTime      @default(now())
  tenantId          Int?
  currency          String?       @default("USD")
  exchangeRate      Float?        @default(1.0)
  installmentNumber Int?          @default(1)
  notes             String?
  receiptNumber     String?       @unique
  invoice           Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  Tenant            Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  verifiedBy        User?         @relation("VerifiedBy", fields: [verifiedById], references: [id])
}

model Message {
  id            Int      @id @default(autoincrement())
  senderId      Int
  receiverId    Int
  applicationId Int?
  messageText   String
  attachmentUrl String?
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
  tenantId      Int?
  receiver      User     @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender        User     @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  Tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Notification {
  id         Int       @id @default(autoincrement())
  userId     Int
  title      String
  message    String
  isRead     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  tenantId   Int?
  actionUrl  String?
  category   String    @default("SYSTEM")
  isArchived Boolean   @default(false)
  priority   String    @default("NORMAL")
  readAt     DateTime?
  Tenant     Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, category])
  @@index([userId, isRead])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  tenantId  Int?
  Tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])
}

model Task {
  id           Int          @id @default(autoincrement())
  title        String
  description  String?
  dueDate      DateTime?
  status       TaskStatus   @default(PENDING)
  priority     TaskPriority @default(MEDIUM)
  assignedToId Int?
  createdById  Int
  createdAt    DateTime     @default(now())
  tenantId     Int?
  assignedTo   User?        @relation("AssignedTo", fields: [assignedToId], references: [id])
  createdBy    User         @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  Tenant       Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model Blog {
  id         Int      @id @default(autoincrement())
  title      String
  slug       String   @unique
  content    String
  coverImage String?
  status     String   @default("DRAFT")
  authorId   Int
  createdAt  DateTime @default(now())
  tenantId   Int?
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  Tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Testimonial {
  id         Int      @id @default(autoincrement())
  clientName String
  clientRole String?
  text       String
  rating     Int      @default(5)
  avatar     String?
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  tenantId   Int?
  Tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model FAQ {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String
  category  String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  tenantId  Int?
  Tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model ContactRequest {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  tenantId  Int?
  Tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Package {
  id             Int           @id @default(autoincrement())
  title          String
  slug           String?       @unique
  country        String
  visaType       String?
  agencyNumber   String
  priceUSD       Float?
  pricePKR       Float?
  priceAFN       Float?
  duration       String?
  processingTime String?
  description    String
  documents      String
  image          String?
  featured       Boolean       @default(true)
  status         String        @default("ACTIVE")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  applications   Application[]
}

model Account {
  id           Int            @id @default(autoincrement())
  code         String
  name         String
  type         AccountType    @default(EXPENSE)
  balance      Float          @default(0)
  tenantId     Int?
  Tenant       Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  JournalEntry JournalEntry[]
}

model AgencyBankAccount {
  id            Int      @id @default(autoincrement())
  bankName      String
  branchName    String?
  accountTitle  String
  accountNumber String
  iban          String
  swiftCode     String?
  currency      String   @default("PKR")
  isDefault     Boolean  @default(false)
  qrCodeUrl     String?
  bankLogoUrl   String?
  createdAt     DateTime @default(now())
  tenantId      Int?
  Tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AgencyBranch {
  id          Int      @id @default(autoincrement())
  branchName  String
  branchCode  String
  managerName String?
  phone       String?
  email       String?
  address     String?
  city        String?
  country     String?  @default("Pakistan")
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  tenantId    Int?
  Tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AgencyDocument {
  id                 Int       @id @default(autoincrement())
  documentTitle      String
  documentType       String
  fileUrl            String
  fileSize           String?
  issueDate          DateTime?
  expiryDate         DateTime?
  verificationStatus String    @default("VERIFIED")
  createdAt          DateTime  @default(now())
  tenantId           Int?
  Tenant             Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AirTicket {
  id            Int      @id @default(autoincrement())
  pnr           String   @unique
  airline       String
  passengerName String
  departure     String
  arrival       String
  departureDate DateTime
  ticketCost    Float
  sellingPrice  Float
  commission    Float    @default(0)
  status        String   @default("CONFIRMED")
  createdAt     DateTime @default(now())
  tenantId      Int?
  Tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Announcement {
  id             Int       @id @default(autoincrement())
  isSuperAdmin   Boolean   @default(false)
  title          String
  content        String
  type           String    @default("INFO")
  displayFormat  String    @default("TOP_BANNER")
  targetAudience Json?
  priority       String    @default("NORMAL")
  isSticky       Boolean   @default(false)
  isPinned       Boolean   @default(false)
  isDismissible  Boolean   @default(true)
  status         String    @default("PUBLISHED")
  publishedAt    DateTime  @default(now())
  expiresAt      DateTime?
  readsCount     Int       @default(0)
  clicksCount    Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  tenantId       Int?
  actionText     String?
  actionUrl      String?
  Tenant         Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([isSuperAdmin, status])
  @@index([tenantId, status])
}

model Applicant {
  id               Int           @id @default(autoincrement())
  applicantId      String        @unique
  photoUrl         String?
  passportScanUrl  String?
  cnicScanUrl      String?
  firstName        String
  lastName         String
  fatherName       String?
  motherName       String?
  gender           String?
  dob              String?
  age              Int?
  nationality      String?
  passportNumber   String?
  passportExpiry   String?
  issueDate        String?
  issuePlace       String?
  maritalStatus    String?
  education        String?
  occupation       String?
  currentAddress   String?
  permanentAddress String?
  email            String?
  phone            String?
  emergencyContact String?
  notes            String?
  tags             String[]      @default([])
  status           String        @default("ACTIVE")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime
  tenantId         Int?
  Tenant           Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Application      Application[]
  VisaCase         VisaCase[]
}

model BroadcastMessage {
  id          Int      @id @default(autoincrement())
  title       String
  targetGroup String
  channel     String   @default("BOTH")
  messageBody String
  sentCount   Int      @default(0)
  failedCount Int      @default(0)
  status      String   @default("COMPLETED")
  createdAt   DateTime @default(now())
  tenantId    Int?
  Tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model CRMLead {
  id              Int           @id @default(autoincrement())
  trackingId      String        @unique
  name            String
  email           String?
  phone           String?
  source          CRMLeadSource @default(WALK_IN)
  status          CRMLeadStatus @default(NEW)
  service         String?
  notes           String?
  followUpDate    DateTime?
  assignedStaffId Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  tenantId        Int?
  User            User?         @relation(fields: [assignedStaffId], references: [id])
  Tenant          Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model CaseActivity {
  id            Int      @id @default(autoincrement())
  caseId        Int
  action        String
  details       String?
  performedById Int?
  createdAt     DateTime @default(now())
  tenantId      Int?
  VisaCase      VisaCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  User          User?    @relation(fields: [performedById], references: [id])
  Tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model CaseAppointment {
  id        Int      @id @default(autoincrement())
  caseId    Int
  type      String
  date      DateTime
  timeSlot  String?
  location  String?
  status    String   @default("SCHEDULED")
  notes     String?
  createdAt DateTime @default(now())
  tenantId  Int?
  VisaCase  VisaCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  Tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model CaseDocument {
  id           Int       @id @default(autoincrement())
  caseId       Int
  title        String
  documentType String
  fileUrl      String?
  fileName     String?
  fileSize     Int?
  status       String    @default("MISSING")
  verifiedById Int?
  verifiedAt   DateTime?
  expiryDate   DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  tenantId     Int?
  VisaCase     VisaCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  Tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model CaseTask {
  id           Int       @id @default(autoincrement())
  caseId       Int
  title        String
  description  String?
  dueDate      DateTime?
  assignedToId Int?
  status       String    @default("PENDING")
  priority     String    @default("NORMAL")
  createdAt    DateTime  @default(now())
  tenantId     Int?
  User         User?     @relation(fields: [assignedToId], references: [id])
  VisaCase     VisaCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  Tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model ClientDocument {
  id                 Int           @id @default(autoincrement())
  clientProfileId    Int
  folderCategory     String        @default("GENERAL")
  fileName           String
  fileUrl            String
  fileSize           String?
  expiryDate         DateTime?
  uploadedBy         String?
  createdAt          DateTime      @default(now())
  tenantId           Int?
  ocrData            String?
  verificationStatus String        @default("VERIFIED")
  version            String?       @default("v1.0")
  ClientProfile      ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  Tenant             Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model ClientNote {
  id              Int           @id @default(autoincrement())
  clientProfileId Int
  category        String        @default("GENERAL")
  noteText        String
  isPrivate       Boolean       @default(false)
  authorName      String?
  createdAt       DateTime      @default(now())
  tenantId        Int?
  ClientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  Tenant          Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model ClientTimeline {
  id              Int           @id @default(autoincrement())
  clientProfileId Int
  eventType       String
  description     String
  actorName       String?
  createdAt       DateTime      @default(now())
  tenantId        Int?
  ClientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  Tenant          Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model CommunicationLog {
  id               Int       @id @default(autoincrement())
  recipientName    String
  recipientContact String
  channel          String
  templateName     String?
  subject          String?
  messageBody      String
  status           String    @default("SENT")
  errorMessage     String?
  attachmentUrl    String?
  visaCaseId       Int?
  invoiceId        Int?
  staffName        String?
  createdAt        DateTime  @default(now())
  tenantId         Int?
  bouncedAt        DateTime?
  deliveredAt      DateTime?
  openedAt         DateTime?
  provider         String?   @default("RESEND")
  resendId         String?
  Tenant           Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([resendId])
  @@index([tenantId, recipientContact])
  @@index([tenantId, status])
}

model ContractTemplate {
  id                    Int      @id @default(autoincrement())
  name                  String
  serviceCategory       String
  destinationCountry    String   @default("Global")
  defaultGovernmentFee  Float    @default(0.0)
  defaultAgencyFee      Float    @default(0.0)
  defaultProcessingDays Int      @default(15)
  defaultTerms          String?
  defaultRefundPolicy   String?
  requiredDocuments     Json?    @default("[]")
  isGlobalSuperAdmin    Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime
  tenantId              Int?
  Tenant                Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model ContractVersion {
  id            Int           @id @default(autoincrement())
  contractId    Int
  versionNumber Int
  snapshotJson  Json
  changedBy     String?
  changeReason  String?
  createdAt     DateTime      @default(now())
  SmartContract SmartContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

model Country {
  id                 Int        @id @default(autoincrement())
  name               String
  code               String
  flagUrl            String?
  currency           String     @default("USD")
  embassyNotes       String?
  processingTimeDays Int        @default(15)
  tenantId           Int?
  Tenant             Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  VisaType           VisaType[]
}

model CreditNote {
  id               Int      @id @default(autoincrement())
  creditNoteNumber String   @unique
  invoiceId        Int
  amount           Float
  reason           String?
  status           String   @default("ISSUED")
  createdAt        DateTime @default(now())
  tenantId         Int?
  Invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  Tenant           Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model CustomWorkflow {
  id              Int      @id @default(autoincrement())
  name            String
  description     String?
  trigger         String
  conditions      Json?
  actions         Json
  status          String   @default("ACTIVE")
  executionsCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime
  tenantId        Int?
  Tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model EmailConfig {
  id             Int      @id @default(autoincrement())
  provider       String   @default("SMTP")
  host           String?
  port           Int?     @default(587)
  username       String?
  password       String?
  encryption     String?  @default("TLS")
  senderName     String?
  senderEmail    String?
  replyToEmail   String?
  emailSignature String?
  status         String   @default("DISCONNECTED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  tenantId       Int?
  Tenant         Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model EmailSuppression {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  reason    String   @default("HARD_BOUNCE")
  source    String?  @default("RESEND")
  resendId  String?
  createdAt DateTime @default(now())
}

model ExchangeRate {
  id           Int      @id @default(autoincrement())
  tenantId     Int
  fromCurrency String
  toCurrency   String
  rate         Float
  isLocked     Boolean  @default(false)
  updatedAt    DateTime
  Tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fromCurrency, toCurrency])
}

model Expense {
  id         Int             @id @default(autoincrement())
  title      String
  category   ExpenseCategory @default(MISCELLANEOUS)
  amount     Float
  date       DateTime        @default(now())
  receiptUrl String?
  notes      String?
  createdAt  DateTime        @default(now())
  tenantId   Int?
  Tenant     Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model FinanceTransaction {
  id                                                                Int               @id @default(autoincrement())
  tenantId                                                          Int
  transactionNumber                                                 String            @unique
  type                                                              String
  amount                                                            Float
  currency                                                          String            @default("USD")
  exchangeRate                                                      Float             @default(1.0)
  paymentMethod                                                     String            @default("CASH")
  transactionDate                                                   DateTime          @default(now())
  description                                                       String
  category                                                          String            @default("MISCELLANEOUS")
  subcategory                                                       String?
  referenceNumber                                                   String?
  accountId                                                         Int?
  toAccountId                                                       Int?
  clientId                                                          Int?
  supplierId                                                        Int?
  invoiceId                                                         Int?
  applicationId                                                     Int?
  attachment                                                        String?
  notes                                                             String?
  status                                                            String            @default("COMPLETED")
  createdById                                                       Int?
  createdAt                                                         DateTime          @default(now())
  updatedAt                                                         DateTime
  FinancialAccount_FinanceTransaction_accountIdToFinancialAccount   FinancialAccount? @relation("FinanceTransaction_accountIdToFinancialAccount", fields: [accountId], references: [id])
  Application                                                       Application?      @relation(fields: [applicationId], references: [id])
  ClientProfile                                                     ClientProfile?    @relation(fields: [clientId], references: [id])
  User                                                              User?             @relation(fields: [createdById], references: [id])
  Invoice                                                           Invoice?          @relation(fields: [invoiceId], references: [id])
  Supplier                                                          Supplier?         @relation(fields: [supplierId], references: [id])
  Tenant                                                            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  FinancialAccount_FinanceTransaction_toAccountIdToFinancialAccount FinancialAccount? @relation("FinanceTransaction_toAccountIdToFinancialAccount", fields: [toAccountId], references: [id])
}

model FinancialAccount {
  id                                                                  Int                  @id @default(autoincrement())
  tenantId                                                            Int
  name                                                                String
  accountType                                                         String               @default("BANK")
  accountNumber                                                       String?
  bankName                                                            String?
  currency                                                            String               @default("USD")
  openingBalance                                                      Float                @default(0)
  currentBalance                                                      Float                @default(0)
  isDefault                                                           Boolean              @default(false)
  notes                                                               String?
  createdAt                                                           DateTime             @default(now())
  updatedAt                                                           DateTime
  FinanceTransaction_FinanceTransaction_accountIdToFinancialAccount   FinanceTransaction[] @relation("FinanceTransaction_accountIdToFinancialAccount")
  FinanceTransaction_FinanceTransaction_toAccountIdToFinancialAccount FinanceTransaction[] @relation("FinanceTransaction_toAccountIdToFinancialAccount")
  Tenant                                                              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  RecurringExpense                                                    RecurringExpense[]
}

model HotelBooking {
  id           Int       @id @default(autoincrement())
  hotelName    String
  roomType     String?
  guestName    String
  checkIn      DateTime
  checkOut     DateTime
  cost         Float
  sellingPrice Float
  status       String    @default("CONFIRMED")
  supplierId   Int?
  createdAt    DateTime  @default(now())
  tenantId     Int?
  Supplier     Supplier? @relation(fields: [supplierId], references: [id])
  Tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model JournalEntry {
  id          Int      @id @default(autoincrement())
  accountId   Int
  description String
  debit       Float    @default(0)
  credit      Float    @default(0)
  date        DateTime @default(now())
  tenantId    Int?
  Account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  Tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model MarketplaceAd {
  id          Int      @id @default(autoincrement())
  title       String
  tagline     String?
  category    String   @default("SPECIAL_PROMO")
  imageUrl    String?
  badgeText   String   @default("SPECIAL OFFER")
  targetUrl   String?
  placement   String   @default("TOP_HERO_BANNER")
  isActive    Boolean  @default(true)
  viewsCount  Int      @default(0)
  clicksCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model MarketplaceListing {
  id               Int      @id @default(autoincrement())
  title            String
  description      String
  category         String
  pricing          Float    @default(0.0)
  pricingUnit      String   @default("per document")
  deliveryTime     String   @default("24 Hours")
  ecosystem        String   @default("SERVICES")
