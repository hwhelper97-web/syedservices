  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  Tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique
  emailEnabled     Boolean  @default(true)
  inAppEnabled     Boolean  @default(true)
  browserEnabled   Boolean  @default(true)
  whatsappEnabled  Boolean  @default(true)
  mutedCategories  String[] @default([])
  workingHoursOnly Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime
  tenantId         Int?
  Tenant           Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model NotificationRule {
  id          Int      @id @default(autoincrement())
  name        String
  category    String   @default("GENERAL")
  eventKey    String   @unique
  recipients  String[] @default(["TENANT_ADMIN", "CLIENT"])
  channel     String   @default("EMAIL")
  templateId  Int?
  isEnabled   Boolean  @default(true)
  isMandatory Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  tenantId    Int?
  Tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Payable {
  id            Int       @id @default(autoincrement())
  tenantId      Int
  payableNumber String    @unique
  title         String
  supplierId    Int?
  amount        Float
  paidAmount    Float     @default(0)
  balanceAmount Float     @default(0)
  currency      String    @default("USD")
  dueDate       DateTime
  status        String    @default("UNPAID")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  Supplier      Supplier? @relation(fields: [supplierId], references: [id])
  Tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Plan {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  price        Float
  billingCycle String
  features     String[]
  description  String?
  isActive     Boolean  @default(true)
  Tenant       Tenant[]
}

model PublicTracking {
  id             Int         @id @default(autoincrement())
  trackingNumber String      @unique
  applicationId  Int
  status         String
  notes          String?
  updatedAt      DateTime
  Application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model RecurringExpense {
  id               Int               @id @default(autoincrement())
  tenantId         Int
  title            String
  category         String            @default("OFFICE_RENT")
  amount           Float
  currency         String            @default("USD")
  frequency        String            @default("MONTHLY")
  startDate        DateTime          @default(now())
  nextDueDate      DateTime
  lastPostedDate   DateTime?
  autoPost         Boolean           @default(false)
  accountId        Int?
  paymentMethod    String            @default("BANK_TRANSFER")
  description      String?
  status           String            @default("ACTIVE")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime
  FinancialAccount FinancialAccount? @relation(fields: [accountId], references: [id])
  Tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Refund {
  id           Int      @id @default(autoincrement())
  refundNumber String   @unique
  invoiceId    Int
  amount       Float
  reason       String?
  method       String   @default("CASH")
  status       String   @default("PROCESSED")
  createdAt    DateTime @default(now())
  tenantId     Int?
  Invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  Tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model ScheduledMessage {
  id               Int      @id @default(autoincrement())
  recipientName    String
  recipientContact String
  channel          String
  templateName     String?
  messageBody      String
  scheduledFor     DateTime
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())
  tenantId         Int?
  Tenant           Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model SmartContract {
  id                       Int                 @id @default(autoincrement())
  contractNumber           String              @unique
  clientId                 Int?
  clientName               String?
  clientEmail              String?
  clientPhone              String?
  serviceCategory          String
  destinationCountry       String
  visaCategory             String              @default("Tourist Visa")
  processingDays           Int                 @default(15)
  estimatedCompletionDate  DateTime?
  governmentFee            Float               @default(0.0)
  agencyFee                Float               @default(0.0)
  taxAmount                Float               @default(0.0)
  discountAmount           Float               @default(0.0)
  urgentFee                Float               @default(0.0)
  totalAmount              Float               @default(0.0)
  currency                 String              @default("USD")
  optionalServices         Json?               @default("[]")
  requiresInvitationLetter Boolean             @default(false)
  invitationStatus         String?             @default("NOT_REQUIRED")
  termsAndConditions       String?
  legalClauses             String?
  cancellationPolicy       String?
  refundPolicy             String?
  specialNotes             String?
  status                   String              @default("DRAFT")
  version                  Int                 @default(1)
  clientSignatureUrl       String?
  clientSignatureType      String?
  clientSignedAt           DateTime?
  clientSignedIp           String?
  agencySignatureUrl       String?
  agencySignatureType      String?
  agencySignedAt           DateTime?
  agencySignedIp           String?
  agencySignerName         String?
  caseId                   Int?
  invoiceId                Int?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime
  tenantId                 Int?
  ContractVersion          ContractVersion[]
  VisaCase                 VisaCase?           @relation(fields: [caseId], references: [id])
  ClientProfile            ClientProfile?      @relation(fields: [clientId], references: [id])
  Invoice                  Invoice?            @relation(fields: [invoiceId], references: [id])
  Tenant                   Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  VisaCaseMilestone        VisaCaseMilestone[]

  @@index([tenantId, destinationCountry])
  @@index([tenantId, status])
}

model StaffAttendance {
