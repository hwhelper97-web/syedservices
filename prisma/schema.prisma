  Payable                Payable[]
  Payment                Payment[]
  RecurringExpense       RecurringExpense[]
  Refund                 Refund[]
  ScheduledMessage       ScheduledMessage[]
  SmartContract          SmartContract[]
  StaffAttendance        StaffAttendance[]
  StaffLeave             StaffLeave[]
  StaffProfile           StaffProfile[]
  Supplier               Supplier[]
  SupportTicket          SupportTicket[]
  Task                   Task[]
  Template               Template[]
  Plan                   Plan?                    @relation(fields: [planId], references: [id])
  TenantSetting          TenantSetting[]
  Testimonial            Testimonial[]
  TourPackage            TourPackage[]
  User                   User[]
  VisaCase               VisaCase[]
  WhatsAppConfig         WhatsAppConfig[]
}

model TenantSetting {
  id       Int    @id @default(autoincrement())
  tenantId Int
  key      String
  value    String
  Tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
}

model TicketMessage {
  id            Int           @id @default(autoincrement())
  ticketId      Int
  senderRole    String
  senderName    String        @default("")
  content       String
  fileUrl       String?
  fileName      String?
  fileType      String?
  createdAt     DateTime      @default(now())
  SupportTicket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model TourPackage {
  id           Int      @id @default(autoincrement())
  title        String
  destinations String
  itinerary    String?
  pricing      Float
  durationDays Int      @default(3)
  images       String[] @default([])
  createdAt    DateTime @default(now())
  tenantId     Int?
  Tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model VisaCase {
  id                   Int                 @id @default(autoincrement())
  caseNumber           String              @unique
  clientId             Int?
  applicantId          Int?
  passportNumber       String?
  nationality          String?
  destinationCountry   String
  visaCategory         String
  visaType             String
  processingType       String              @default("NORMAL")
  stage                String              @default("LEAD_RECEIVED")
  priority             String              @default("NORMAL")
  assignedOfficerId    Int?
  submissionDate       DateTime?
  expectedDecisionDate DateTime?
  travelDate           DateTime?
  returnDate           DateTime?
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime
  tenantId             Int?
  CaseActivity         CaseActivity[]
  CaseAppointment      CaseAppointment[]
  CaseDocument         CaseDocument[]
  CaseTask             CaseTask[]
  SmartContract        SmartContract[]
  Applicant            Applicant?          @relation(fields: [applicantId], references: [id])
  User                 User?               @relation(fields: [assignedOfficerId], references: [id])
  ClientProfile        ClientProfile?      @relation(fields: [clientId], references: [id])
  Tenant               Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  VisaCaseMilestone    VisaCaseMilestone[]

  @@index([tenantId, destinationCountry])
  @@index([tenantId, stage])
}

model VisaCaseMilestone {
  id                  Int            @id @default(autoincrement())
  caseId              Int?
  contractId          Int?
  stepNumber          Int
  title               String
  description         String?
  category            String
  status              String         @default("PENDING")
  isConditionalBranch Boolean        @default(false)
  branchConditionKey  String?
  progressPercentage  Int            @default(0)
  completedAt         DateTime?
  responsibleUserId   Int?
  responsibleUserName String?
  notes               String?
  fileUrls            Json?          @default("[]")
  messages            Json?          @default("[]")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime
  VisaCase            VisaCase?      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  SmartContract       SmartContract? @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([contractId])
}

model VisaType {
  id           Int      @id @default(autoincrement())
  countryId    Int
  name         String
  description  String?
  requirements String[] @default([])
  Country      Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
}

model WhatsAppConfig {
  id                 Int      @id @default(autoincrement())
  provider           String   @default("META_CLOUD")
  phoneNumber        String?
  phoneId            String?
  wabaId             String?
  accessToken        String?
  webhookVerifyToken String?
  autoReconnect      Boolean  @default(true)
  status             String   @default("DISCONNECTED")
  createdAt          DateTime @default(now())
  updatedAt          DateTime
  tenantId           Int?
  Tenant             Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

