  @@index([category, isPublished])
  @@index([tenantId])
}

model MarketplaceOrder {
  id                 Int      @id @default(autoincrement())
  orderNumber        String   @unique
  partnerName        String
  serviceCategory    String
  status             String   @default("PENDING_REQUEST")
  amount             Float    @default(0.0)
  notes              String?
  deliveryTime       String?  @default("24 Hours")
  messages           Json?    @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime
  tenantId           Int?
  partnerTenantId    Int?
  budget             Float    @default(0.0)
  counterOfferNotes  String?
  deadline           String?  @default("24 Hours")
  platformCommission Float    @default(0.0)
  priority           String   @default("REGULAR")
  providerEarnings   Float    @default(0.0)
  settlementStatus   String   @default("UNSETTLED")
  Tenant             Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([partnerTenantId])
  @@index([tenantId, status])
}

model MessageTemplate {
  id          Int      @id @default(autoincrement())
  name        String
  category    String
  channel     String   @default("BOTH")
  subject     String?
  messageBody String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  tenantId    Int?
  Tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model MobileWallet {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  provider      String
  accountName   String
  accountNumber String
  currency      String   @default("PKR")
  instructions  String?
